{
  "name": "@forgeopslabs/fluxgate-angular",
  "version": "0.0.0-dev",
  "description": "Angular providers, signals and directive for FluxGate feature flags",
  "license": "Apache-2.0",
  "author": "ForgeOps LABS",
  "homepage": "https://github.com/forgeopslabs/fluxgate-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgeopslabs/fluxgate-js.git",
    "directory": "packages/angular"
  },
  "keywords": [
    "fluxgate",
    "feature-flags",
    "angular",
    "signals"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "test": "ng-packagr -p ng-package.json -c tsconfig.lib.json >/dev/null && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@angular/core": ">=19.0.0",
    "@forgeopslabs/fluxgate": "workspace:^"
  },
  "devDependencies": {
    "@angular/common": "~19.2.25",
    "@angular/compiler": "~19.2.25",
    "@angular/compiler-cli": "~19.2.25",
    "@angular/core": "~19.2.25",
    "@angular/platform-browser": "~19.2.25",
    "@angular/platform-browser-dynamic": "~19.2.25",
    "@forgeopslabs/fluxgate": "workspace:*",
    "jsdom": "^26.1.0",
    "ng-packagr": "~19.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
