{
  "name": "@forgeopslabs/fluxgate-react",
  "version": "0.0.0-dev",
  "description": "React provider and hooks for FluxGate feature flags",
  "license": "Apache-2.0",
  "author": "ForgeOps LABS",
  "homepage": "https://github.com/forgeopslabs/fluxgate-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgeopslabs/fluxgate-js.git",
    "directory": "packages/react"
  },
  "keywords": ["fluxgate", "feature-flags", "react", "hooks"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@forgeopslabs/fluxgate": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@forgeopslabs/fluxgate": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
